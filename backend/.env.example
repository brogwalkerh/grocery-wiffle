# ========================================
# GroceryCompare Backend Configuration
# ========================================
# Copy this file to .env and fill in your API keys

# Application Settings
APP_NAME=GroceryCompare API
APP_VERSION=1.0.0
API_PREFIX=/api
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/grocery_compare
# For development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./grocery_compare.db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
PRICE_CACHE_HOURS=24
CIRCULAR_CACHE_HOURS=168

# Price Crawler Settings
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_HOURS=6
CRAWLER_RATE_LIMIT_RPS=0.5

# ========================================
# API Keys (Get these for better data!)
# ========================================

# FLIPP API - Weekly Circulars (MOST RELIABLE!)
# -------------------------------------------------
# Flipp aggregates weekly ads from 800+ retailers
# This is the BEST source for accurate sale prices
# 
# Options:
# 1. Business API (paid): https://flipp.com/business
# 2. Use public endpoints (current - may be rate limited)
#
# FLIPP_API_KEY=
# FLIPP_PUBLISHER_ID=

# USDA FoodData Central - Product Database (FREE!)
# -------------------------------------------------
# Official US government food database
# Sign up: https://fdc.nal.usda.gov/api-key-signup.html
# 
# DEMO_KEY limits: 25 requests/hour per IP
# Real key limits: 3,600 requests/hour
# 
# Get your FREE key now! Takes 30 seconds.
USDA_API_KEY=DEMO_KEY

# Kroger API - Official Kroger Prices (FREE!)
# -------------------------------------------------
# Covers Kroger, Ralphs, Fred Meyer, Fry's, King Soopers, etc.
# Sign up: https://developer.kroger.com/
# Limits: 10,000 calls/day (free tier)
#
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_BASE_URL=https://api.kroger.com/v1

# Instacart Developer API (if available)
# -------------------------------------------------
# https://www.instacart.com/developer
# Note: Currently in closed beta
#
# INSTACART_API_KEY=

# Google Maps API - Store Locations
# -------------------------------------------------
# For finding nearby stores by zip code
# https://console.cloud.google.com/
#
# GOOGLE_MAPS_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# Recommended Setup for Best Results
# ========================================

# Priority 1: Get USDA API key (30 seconds, FREE)
# Visit: https://fdc.nal.usda.gov/api-key-signup.html

# Priority 2: Apply for Kroger API (5 minutes, FREE)
# Visit: https://developer.kroger.com/

# Priority 3: Contact Flipp for business API access
# Visit: https://flipp.com/business

# Priority 4: Google Maps API for store locations
# Visit: https://console.cloud.google.com/
